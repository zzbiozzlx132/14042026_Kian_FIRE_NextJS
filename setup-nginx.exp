#!/usr/bin/expect -f
set timeout 120
set host 222.255.238.138
set user root
set password RaQ362nZi86mwMPxlipk

spawn ssh -o StrictHostKeyChecking=no $user@$host "
  cat > /etc/nginx/sites-available/fire.kiantr.com << 'NGINXEOF'
server {
    listen 80;
    server_name fire.kiantr.com;

    client_max_body_size 20M;

    location / {
        proxy_pass http://localhost:3001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade \\\$http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host \\\$host;
        proxy_set_header X-Real-IP \\\$remote_addr;
        proxy_set_header X-Forwarded-For \\\$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \\\$scheme;
        proxy_cache_bypass \\\$http_upgrade;
    }
}
NGINXEOF

  ln -sf /etc/nginx/sites-available/fire.kiantr.com /etc/nginx/sites-enabled/
  nginx -t && systemctl reload nginx
  certbot --nginx -d fire.kiantr.com --non-interactive --agree-tos --email ceo@kiantr.com --redirect
"

expect {
  "password:" {
    send "$password\r"
    exp_continue
  }
  eof
}
