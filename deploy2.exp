#!/usr/bin/expect -f
set timeout 600
set host [lindex $argv 0]
set user [lindex $argv 1]
set password [lindex $argv 2]

spawn ssh -o StrictHostKeyChecking=no $user@$host "
  cd /root/14042026_Kian_FIRE_NextJS
  git pull origin main
  docker compose up -d --build
"

expect {
  "password:" {
    send "$password\r"
    exp_continue
  }
  eof
}
